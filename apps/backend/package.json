{
  "name": "@korana/backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "npx nest start --watch",
    "build": "npx prisma generate --schema prisma/schema.prisma && npx nest build",
    "start": "node dist/src/main.js",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:generate": "npx prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate deploy --schema prisma/schema.prisma",
    "prices:migrate:sql": "npx prisma db execute --schema prisma/schema.prisma --file prisma/migrations/20260305123000_prices_pipeline/migration.sql",
    "prices:migrate:idempotency:sql": "npx prisma db execute --schema prisma/schema.prisma --file prisma/migrations/20260307120000_price_run_idempotency/migration.sql",
    "prices:seed": "node scripts/seed-price-products.js",
    "test:unit": "node --test test/unit/**/*.test.cjs",
    "test:e2e": "jest --config ./jest.e2e.config.cjs --runInBand"
  },
  "dependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/websockets": "^10.4.15",
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.19.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.6.3",
    "nodemailer": "^6.9.4",
    "googleapis": "^131.0.0"
  },
  "devDependencies": {
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.17.6",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.15.0",
    "jest": "^30.2.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4"
  }
}

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
MOBILE_ORIGIN=exp://localhost:8081
ACCESS_JWT_SECRET=replace_with_strong_access_secret
REFRESH_JWT_SECRET=replace_with_strong_refresh_secret
DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres?schema=public
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=never_use_in_backend_logic_here
SUPABASE_SERVICE_ROLE_KEY=backend_only_never_expose
SUPABASE_STORAGE_BUCKET=korana-estate-assets
PAYMENT_WEBHOOK_SECRET=replace_with_webhook_signing_secret

# Prices scraper pipeline
CRON_SECRET=replace_with_long_random_secret
PRICES_SCRAPER_ENABLED=true
PRICES_SCRAPER_RUNNER=scripts/playwright_prices/run.sh
PRICES_SCRAPER_ENTRY=scrape_prices.py
PRICES_SCRAPER_TIMEOUT_MS=120000
PRICES_SCRAPER_RETRIES=2
PRICES_SCHEDULE_CRON=0 9 * * *
PRICES_SCHEDULE_TIMEZONE=Asia/Kolkata
PRICES_SCHEDULE_TIME_LOCAL=09:00
PRICES_STALE_AFTER_HOURS=30
BROWSER_CHANNEL=

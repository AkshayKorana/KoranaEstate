generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Coffee {
  id          String   @id
  coffeeType  String
  quantity    Int
  pricePerKg  Float
  location    String
  description String?
  createdAt   DateTime @default(now())
}

model Commodity {
  id        String   @id @default(uuid())
  type      String                 // Coffee, Pepper, Cardamom, etc.
  name      String                 // Arabica, Robusta, etc.
  variety   String?                // Optional: variety or grade
  price     Float
  location  String?                // Market or city
  source    String?                // Where the price came from
  createdAt DateTime @default(now())

  @@index([name, variety])         // Optional: fast lookups
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  passwordHash       String
  resetToken         String?   @unique
  resetTokenExpiry   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model PriceObservation {
  id            String   @id @default(cuid())
  commodityName String
  grade         String?
  priceType     String   // benchmark | mandi | listing
  source        String
  marketCenter  String?
  state         String?
  district      String?
  unit          String   // inr_per_kg
  inrPerKg      Float
  originalValue Float?
  originalUnit  String?
  sourceUrl     String?
  reliability   Float?
  observedAt    DateTime
  createdAt     DateTime @default(now())

  @@index([commodityName, priceType, observedAt])
  @@index([source, observedAt])
}

model ForecastRun {
  id             String   @id @default(cuid())
  commodityName  String
  modelVersion   String
  horizonDays    Int
  mape           Float?
  mae            Float?
  rmse           Float?
  trendText      String
  pctMove        Float?
  lowerPct       Float?
  upperPct       Float?
  labelsJson     String
  actualJson     String
  forecastJson   String
  generatedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([commodityName, generatedAt])
  @@index([modelVersion, generatedAt])
}

model ModelLeaderboardSnapshot {
  id           String   @id @default(cuid())
  commodityName String
  modelVersion String
  horizonDays  Int
  mape         Float?
  mae          Float?
  rmse         Float?
  sampleCount  Int
  windowStart  DateTime?
  windowEnd    DateTime?
  generatedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([commodityName, horizonDays, generatedAt])
  @@index([modelVersion, horizonDays, generatedAt])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  eventName  String
  page       String?
  commodity  String?
  horizonDays Int?
  lang       String?
  metaJson   String?
  createdAt  DateTime @default(now())

  @@index([eventName, createdAt])
  @@index([commodity, createdAt])
}

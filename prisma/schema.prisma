generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Coffee {
  id          String   @id
  coffeeType  String
  quantity    Int
  pricePerKg  Float
  location    String
  description String?
  createdAt   DateTime @default(now())
}

model Commodity {
  id        String   @id @default(uuid())
  type      String // Coffee, Pepper, Cardamom, etc.
  name      String // Arabica, Robusta, etc.
  variety   String? // Optional: variety or grade
  price     Float
  location  String? // Market or city
  source    String? // Where the price came from
  createdAt DateTime @default(now())

  @@index([name, variety]) // Optional: fast lookups
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  passwordHash     String
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Marketplace relations
  rawListings           RawListing[]
  rawOffers             RawOffer[]
  products              Product[]
  estateListings        EstateListing[]
  orders                Order[]
  sentMessages          Message[]       @relation("SentMessages")
  conversationsAsBuyer  Conversation[]  @relation("BuyerConversations")
  conversationsAsSeller Conversation[]  @relation("SellerConversations")

  // Reviews received (fix for Review.target relation)
  reviewsReceived Review[] @relation("review_target")
}

model PriceObservation {
  id            String   @id @default(cuid())
  commodityName String
  grade         String?
  priceType     String // benchmark | mandi | listing
  source        String
  marketCenter  String?
  state         String?
  district      String?
  unit          String // inr_per_kg
  inrPerKg      Float
  originalValue Float?
  originalUnit  String?
  sourceUrl     String?
  reliability   Float?
  observedAt    DateTime
  createdAt     DateTime @default(now())

  @@index([commodityName, priceType, observedAt])
  @@index([source, observedAt])
}

model ForecastRun {
  id            String   @id @default(cuid())
  commodityName String
  modelVersion  String
  horizonDays   Int
  mape          Float?
  mae           Float?
  rmse          Float?
  trendText     String
  pctMove       Float?
  lowerPct      Float?
  upperPct      Float?
  labelsJson    String
  actualJson    String
  forecastJson  String
  generatedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([commodityName, generatedAt])
  @@index([modelVersion, generatedAt])
}

model ModelLeaderboardSnapshot {
  id            String    @id @default(cuid())
  commodityName String
  modelVersion  String
  horizonDays   Int
  mape          Float?
  mae           Float?
  rmse          Float?
  sampleCount   Int
  windowStart   DateTime?
  windowEnd     DateTime?
  generatedAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([commodityName, horizonDays, generatedAt])
  @@index([modelVersion, horizonDays, generatedAt])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventName   String
  page        String?
  commodity   String?
  horizonDays Int?
  lang        String?
  metaJson    String?
  createdAt   DateTime @default(now())

  @@index([eventName, createdAt])
  @@index([commodity, createdAt])
}

// ========================================
// MARKETPLACE MODELS
// ========================================

// Raw Commodity Marketplace (Farmer Trading)
model RawListing {
  id          String   @id @default(cuid())
  sellerId    String
  commodity   String // Arabica Cherry, Robusta Parchment, Pepper, etc.
  grade       String? // A, AA, Premium, etc.
  quantityKg  Float
  pricePerKg  Float
  location    String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller User       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  offers RawOffer[]

  @@index([commodity, isActive, createdAt])
  @@index([sellerId, isActive])
  @@index([location, commodity])
}

model RawOffer {
  id         String   @id @default(cuid())
  listingId  String
  buyerId    String
  offerPrice Float
  quantity   Float // kg requested
  message    String?
  status     String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, CANCELLED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  listing RawListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer   User       @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([listingId, status])
  @@index([buyerId, status])
}

// Finished Product Marketplace (E-commerce)
model Product {
  id          String   @id @default(cuid())
  sellerId    String
  name        String
  category    String // Coffee Powder, Roasted Beans, Pepper Powder, etc.
  price       Float
  stock       Int      @default(0)
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller User    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([category, isActive, createdAt])
  @@index([sellerId, isActive])
}

model EstateListing {
  id           String   @id @default(cuid())
  sellerId     String
  title        String
  category     String // Fertilizer | Machinery | Tool | Service | Irrigation | Labor
  subcategory  String?
  listingType  String // Product | Service
  price        Float
  unit         String // per_kg | per_bag | per_hour | per_day | fixed
  quantity     Float?
  location     String
  description  String?
  contactPhone String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([category, listingType, isActive, createdAt])
  @@index([sellerId, isActive])
  @@index([location, category])
}

model Order {
  id              String   @id @default(cuid())
  buyerId         String
  productId       String
  quantity        Int
  totalPrice      Float
  status          String   @default("PLACED")
  shippingAddress String?
  phone           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  buyer   User    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  reviews Review[] // <-- Add this line as the opposite relation
}

// Chat System
model Conversation {
  id            String   @id @default(cuid())
  buyerId       String
  sellerId      String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([buyerId, sellerId])
  @@index([buyerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model Review {
  id       String  @id @default(cuid())
  orderId  String?
  order    Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  targetId String
  target   User    @relation("review_target", fields: [targetId], references: [id])
}

{
  "name": "coffee-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.2.4",
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "next dev",
    "dev:raw": "next dev",
    "dev:web": "node scripts/run-web-dev.mjs",
    "dev:backend": "node scripts/run-backend-dev.mjs",
    "setup:all": "node scripts/setup-all.mjs",
    "doctor": "node scripts/doctor.mjs",
    "prisma:generate:web": "prisma generate --schema prisma/schema.prisma",
    "prisma:generate:backend": "npm --prefix korana-estate/backend run prisma:generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "openai": "^6.22.0",
    "prisma": "^6.19.2",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^10.0.1",
    "eslint-config-next": "^0.2.4",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
